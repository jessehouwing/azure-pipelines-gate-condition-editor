<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '20.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Microsoft\TeamFoundationServer\20.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '20.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\TeamFoundationServer\20.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '19.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Microsoft\TeamFoundationServer\19.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '19.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\TeamFoundationServer\19.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '18.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Microsoft\TeamFoundationServer\18.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '18.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\TeamFoundationServer\18.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '17.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Microsoft\TeamFoundationServer\17.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)' == '' and '$(MSBuildRuntimeType)' != 'Core' and ('$(AzureDevOpsServerVersion)' == '' or '$(AzureDevOpsServerVersion)' == '17.0')">$(Registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\TeamFoundationServer\17.0@InstallPath)</TfsInstallationDirectory>
  </PropertyGroup>

  <Target Name="ValidateServerInstallation" BeforeTargets="ResolveReferences">
    <Error Condition="'$(AzureDevOpsServerVersion)' != '' and '$(AzureDevOpsServerVersion)' != '17.0' and '$(AzureDevOpsServerVersion)' != '18.0' and '$(AzureDevOpsServerVersion)' != '19.0' and '$(AzureDevOpsServerVersion)' != '20.0'"
           Text="AzureDevOpsServerVersion must be 17.0, 18.0, 19.0 or 20.0." />
    <Error Condition="'$(TfsInstallationDirectory)' == '' or !Exists('$(TfsInstallationDirectory)\Tools\Microsoft.TeamFoundation.DistributedTask.WebApi.dll')"
           Text="Azure DevOps Server assemblies were not found. Install the selected server version or set TfsInstallationDirectory to its installation directory." />
    <Error Condition="!Exists('$(TfsInstallationDirectory)\Tools\Plugins\Microsoft.TeamFoundation.DistributedTask.Orchestration.Server.Extensions.dll')"
           Text="The server extensions assembly was not found under $(TfsInstallationDirectory)\Tools\Plugins." />
  </Target>
</Project>
